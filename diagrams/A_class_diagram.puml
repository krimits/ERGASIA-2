@startuml
title Διάγραμμα Κλάσεων - Σύστημα Διοδίων

skinparam classAttributeIconSize 0
skinparam backgroundColor #FFFFFF

class SταθμόςΔιοδίων {
  - id: String
  - όνομα: String
  - τοποθεσία: String
  + καταγραφήΔιέλευσης(όχημα, χρόνος): Διέλευση
  + υπολογισμόςΧρέωσης(κατηγορία): double
}

class Όχημα {
  - πινακίδα: String
  - κατηγορία: ΚατηγορίαΟχήματος
  + getΠινακίδα(): String
  + getΚατηγορία(): ΚατηγορίαΟχήματος
}

class ΚατηγορίαΟχήματος {
  - κωδικός: String
  - περιγραφή: String
  + getΠεριγραφή(): String
}

class Διέλευση {
  - id: String
  - ημερομηνίαΏρα: DateTime
  - κόστος: double
  + υπολογισμόςΚόστους(): double
  + getΗμερομηνίαΏρα(): DateTime
}

class Διαδρομή {
  - id: String
  - απόσταση: double
  - ελάχιστοςΧρόνος: int
  + έλεγχοςΥπέρβασηςΤαχύτητας(χρόνοςΔιέλευσης): boolean
  + getΕλάχιστοςΧρόνος(): int
}

class ΠαράβασηΤαχύτητας {
  - id: String
  - ημερομηνία: Date
  - χρόνοςΔιέλευσης: int
  - υπέρβαση: boolean
  + καταγραφήΠαράβασης(): void
}

class Τιμολόγιο {
  - id: String
  - τέλος: double
  + getTέλος(): double
  + setTέλος(τέλος: double): void
}

class Αστυνομία {
  - email: String
  - τηλέφωνο: String
  + λήψηΕνημέρωσηςΠαραβάσεων(παραβάσεις: List): void
}

class ΣύστημαΔιαχείρισης {
  - ημερομηνία: Date
  + ανίχνευσηΠαράβασης(διαδρομή, χρόνος): ΠαράβασηΤαχύτητας
  + ενημέρωσηΑστυνομίας(): void
  + δημιουργίαΗμερήσιαςΑναφοράς(): Report
}

' Σχέσεις
SταθμόςΔιοδίων "1" -- "0..*" Διέλευση : καταγράφει >
Όχημα "1" -- "0..*" Διέλευση : πραγματοποιεί >
Όχημα "1..*" -- "1" ΚατηγορίαΟχήματος : ανήκει σε >

Διαδρομή "1" -- "1" SταθμόςΔιοδίων : ξεκινά από >
Διαδρομή "1" -- "1" SταθμόςΔιοδίων : καταλήγει σε >

SταθμόςΔιοδίων "1" -- "0..*" Τιμολόγιο : έχει >
ΚατηγορίαΟχήματος "1" -- "0..*" Τιμολόγιο : καθορίζει τέλος για >

ΠαράβασηΤαχύτητας "0..*" -- "1" Όχημα : αφορά >
ΠαράβασηΤαχύτητας "0..*" -- "1" Διαδρομή : εντοπίζεται σε >

ΣύστημαΔιαχείρισης "1" -- "0..*" SταθμόςΔιοδίων : διαχειρίζεται >
ΣύστημαΔιαχείρισης "1" -- "0..*" ΠαράβασηΤαχύτητας : καταγράφει >
ΣύστημαΔιαχείρισης "1" -- "1" Αστυνομία : ενημερώνει >

note right of Διαδρομή
  Αν χρόνοςΔιέλευσης < ελάχιστοςΧρόνος
  τότε ανιχνεύεται παράβαση ταχύτητας
end note

note right of ΣύστημαΔιαχείρισης
  Ημερήσια ενημέρωση της
  αστυνομίας για παραβάσεις
end note

@enduml
